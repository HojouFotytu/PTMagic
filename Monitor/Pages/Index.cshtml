@page
@model IndexModel
@{
  ViewData["Title"] = "";
}

@section Styles {
  <link href="@Html.Raw(Model.PTMagicConfiguration.GeneralSettings.Monitor.RootUrl)assets/plugins/nvd3/nv.d3.min.css" rel="stylesheet" type="text/css" />
}

<div id="dashboardTop"><i class="fa fa-circle-o-notch fa-spin fa-3x fa-fw"></i></div>
<div id="dashboardBottom"><i class="fa fa-circle-o-notch fa-spin fa-3x fa-fw"></i></div>

<div id="dca-chart" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
  <div class="modal-dialog modal-full">
    <div class="modal-content">
      <i class="fa fa-circle-o-notch fa-spin fa-3x fa-fw"></i>
    </div><!-- /.modal-content -->
  </div><!-- /.modal-dialog -->
</div><!-- /.modal -->

@section Scripts {
  <script type="text/javascript" src="https://s3.tradingview.com/tv.js"></script>
  <script src="@Html.Raw(Model.PTMagicConfiguration.GeneralSettings.Monitor.RootUrl)assets/plugins/d3/d3.min.js"></script>
  <script src="@Html.Raw(Model.PTMagicConfiguration.GeneralSettings.Monitor.RootUrl)assets/plugins/nvd3/nv.d3.min.js"></script>

  <script type="text/javascript">
    var errCountIndex = [];

    var dashboardTopTimer = null;
    var possibleBuysTimer = null;
    var possibleBuysRequestRunning = false;
    var lastPossibleBuysCount = '—';
    var dashboardBottomTimer = null;
    var dashboardTopRequestRunning = false;
    var dashboardBottomRequestRunning = false;

    var dashboardTopRefreshMilliseconds = 5 * 1000;
    var dashboardBottomRefreshMilliseconds = @Model.PTMagicConfiguration.GeneralSettings.Monitor.DashboardChartsRefreshSeconds * 1000;

    var scheduleDashboardTop = function () {
      clearTimeout(dashboardTopTimer);

      if (!document.hidden) {
        dashboardTopTimer = setTimeout(loadDashboardTop, dashboardTopRefreshMilliseconds);
      }
    };

    var scheduleDashboardBottom = function () {
      clearTimeout(dashboardBottomTimer);

      if (!document.hidden) {
        dashboardBottomTimer = setTimeout(loadDashboardBottom, dashboardBottomRefreshMilliseconds);
      }
    };

    // The PBL count has an independent endpoint and timeout. It never waits
    // on, replaces, or stops the Positions/DashboardTop request.
    var loadPossibleBuysCount = function () {
      if (document.hidden || possibleBuysRequestRunning ||
          $('#possible-buys-count').length === 0) {
        return;
      }

      possibleBuysRequestRunning = true;
      $.ajax({
        url: '@Html.Raw(Model.PTMagicConfiguration.GeneralSettings.Monitor.RootUrl)_get/PossibleBuysCount',
        type: 'GET',
        dataType: 'text',
        timeout: 5000,
        cache: false
      }).done(function (countText) {
        var count = $.trim(countText);
        if (count === 'returntologin') {
          window.location.replace('@Html.Raw(Model.PTMagicConfiguration.GeneralSettings.Monitor.RootUrl)Login');
          return;
        }
        if (/^\d+$/.test(count)) {
          lastPossibleBuysCount = count;
          $('#possible-buys-count').text(count);
        } else {
          lastPossibleBuysCount = '—';
          $('#possible-buys-count').text('—');
        }
      }).fail(function () {
        lastPossibleBuysCount = '—';
        $('#possible-buys-count').text('—');
      }).always(function () {
        possibleBuysRequestRunning = false;
        clearTimeout(possibleBuysTimer);
        if (!document.hidden) {
          possibleBuysTimer = setTimeout(loadPossibleBuysCount, dashboardTopRefreshMilliseconds);
        }
      });
    };

    var loadDashboardTop = function () {
      if (document.hidden || dashboardTopRequestRunning) {
        return;
      }

      dashboardTopRequestRunning = true;
      $('#baglist-refresh-icon, #buylist-refresh-icon').html(
        '<i class="fa fa-circle-o-notch fa-spin fa-fw" title="Loading fresh data..."></i>'
      );

      $.ajax({
        url: '@Html.Raw(Model.PTMagicConfiguration.GeneralSettings.Monitor.RootUrl)_get/DashboardTop',
        type: 'GET',
        dataType: 'html',
        timeout: 10000,
        cache: false
      }).done(function (responseText) {
        try {
          if ($.trim(responseText) === 'returntologin') {
            window.location.replace('@Html.Raw(Model.PTMagicConfiguration.GeneralSettings.Monitor.RootUrl)Login');
            return;
          }
          $('#dashboardTop').html(responseText);
          $('#possible-buys-count').text(lastPossibleBuysCount);
          cleanupOrphanedTooltips();
          $('[data-toggle="tooltip"]').tooltip();
          $('.text-autocolor').autocolor(false);
          // Count retrieval does not delay the main dashboard's next refresh.
          if ($('#possible-buys-count').length) {
            loadPossibleBuysCount();
          }
          errCountIndex['DashboardTop'] = 0;
        } catch (error) {
          console.error('DashboardTop render error:', error);
          errCountIndex['DashboardTop']++;
        }
      }).fail(function (_xhr, status) {
        errCountIndex['DashboardTop']++;
        if (errCountIndex['DashboardTop'] > 2) {
          $.Notification.notify('error', 'top left', 'Dashboard (Top) update failed!',
            'Top dashboard request failed (' + status + '). Checking again automatically.');
        }
      }).always(function () {
        dashboardTopRequestRunning = false;
        $('#baglist-refresh-icon, #buylist-refresh-icon').html('');
        scheduleDashboardTop();
      });
    };

    var loadDashboardBottom = function () {
      if (document.hidden || dashboardBottomRequestRunning) {
        return;
      }

      dashboardBottomRequestRunning = true;

      if (typeof window.cleanupDashboardBottomCharts === 'function') {
        window.cleanupDashboardBottomCharts();
      }

      // Load dashboard
      $("#dashboardBottom").load('@Html.Raw(Model.PTMagicConfiguration.GeneralSettings.Monitor.RootUrl)_get/DashboardBottom', '', function (responseText, textStatus, XMLHttpRequest) {
        if (textStatus == 'error') {
          errCountIndex["DashboardBottom"]++;
          if (errCountIndex["DashboardBottom"] > 2) {
            $.Notification.notify('error', 'top left', 'Dashboard (Bottom) update failed!', 'PTMagic Monitor failed to update data. If this error does not go away by itself, please check the connection to your hosting PC.')
          }
        } else if (responseText == 'returntologin') {
          window.location.replace("@Html.Raw(Model.PTMagicConfiguration.GeneralSettings.Monitor.RootUrl)Login");
          return;
        } else {
          errCountIndex["DashboardBottom"] = 0;
        }

        dashboardBottomRequestRunning = false;
        scheduleDashboardBottom();
      });
    };

    $(document).ready(function () {
      errCountIndex["DashboardTop"] = 0;
      loadDashboardTop();

      errCountIndex["DashboardBottom"] = 0;
      loadDashboardBottom();

      document.addEventListener("visibilitychange", function () {
        clearTimeout(dashboardTopTimer);
        clearTimeout(dashboardBottomTimer);
        clearTimeout(possibleBuysTimer);

        if (!document.hidden) {
          if (!dashboardTopRequestRunning) {
            loadDashboardTop();
          }

          if (!dashboardBottomRequestRunning) {
            loadDashboardBottom();
          }
          if (!possibleBuysRequestRunning) {
            loadPossibleBuysCount();
          }
        }
      });
    });
  </script>
}