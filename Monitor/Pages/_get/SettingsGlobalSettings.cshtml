@page
@model SettingsGlobalSettingsModel
@using Monitor.Configuration
@{
  Layout = null;
}
<div id="GlobalSetting_@Model.SettingName">
  <a name="GlobalSetting_@Model.SettingName"></a>
  <div class="row">
    <div class="col-md-12">
      <div class="card-box">
        @if (!Model.GlobalSetting.SettingName.Equals("")) {
          <h4 class="m-t-0 m-b-20 header-title">
            Global Setting "<span class="text-ptmagic">@Model.GlobalSetting.SettingName</span>"
            @if (!Model.IsDefaultSetting) {
              <button type="button" class="btn btn-ptmagic text-uppercase waves-effect waves-light btn-sort btn-xs pull-right btn-move-GS btn-move-GS@(Model.SettingName)" data-datadirection="down" data-datatarget="GlobalSetting_@Model.SettingName" data-toggle="tooltip" data-placement="top" title="Move down"><i class="fa fa-chevron-down"></i></button>
              <button type="button" class="btn btn-ptmagic text-uppercase waves-effect waves-light btn-sort btn-xs pull-right btn-move-GS btn-move-GS@(Model.SettingName) m-r-5" data-datadirection="up" data-datatarget="GlobalSetting_@Model.SettingName" data-toggle="tooltip" data-placement="top" title="Move up"><i class="fa fa-chevron-up"></i></button>
            }
          </h4>
        } else {
          <h4 class="m-t-0 header-title">New Global Setting</h4>
        }

        <div class="form-group row">
          <label class="col-md-4 col-form-label">Setting Name (Unique) <i class="fa fa-info-circle text-muted" data-toggle="tooltip" data-placement="top" title="UNIQUE name of your setting"></i></label>
          <div class="col-md-8">
            @if (!Model.IsDefaultSetting) {
              <input type="text" class="form-control" name="MarketAnalyzer_GlobalSetting_@(Model.SettingName)|SettingName" value="@Model.GlobalSetting.SettingName">
              <span class="help-block"><small>Use a unique setting name.</small></span>
            } else {
              <input type="hidden" class="form-control" name="MarketAnalyzer_GlobalSetting_@(Model.SettingName)|SettingName" value="@Model.GlobalSetting.SettingName">
              @Model.GlobalSetting.SettingName
            }
          </div>
        </div>

        @if (!Model.IsDefaultSetting) {
          <div class="form-group row">
            <label class="col-md-4 col-form-label">Trigger Connection <i class="fa fa-info-circle text-muted" data-toggle="tooltip" data-placement="top" title="AND / OR, or a Boolean expression using the trigger Tags (for example A &amp;&amp; !B)"></i></label>
            <input type="text" name="MarketAnalyzer_GlobalSetting_@(Model.SettingName)|TriggerConnection" class="form-control" value="@Model.GlobalSetting.TriggerConnection" />
          </div>

          <hr />

          <h5 class="header-title m-b-20">Triggers (@Model.GlobalSetting.Triggers.Count)</h5>
          <input type="hidden" name="MarketAnalyzer_GlobalSetting_@(Model.SettingName)|TriggersRendered" value="true" />
          <div id="MarketAnalyzer_GlobalSetting_@(Model.SettingName)_Triggers"></div>

          <button type="button" id="btn-new-standardtrigger-GS@(Model.SettingName)" class="btn btn-ptmagic btn-custom  btn-block text-uppercase waves-effect waves-light m-b-20" data-datatarget="MarketAnalyzer_GlobalSetting_@(Model.SettingName)_Triggers">
            Add Trigger
          </button>
        }

        <hr />

        <h5 class="header-title m-b-20">Pairs Properties (@(Model.GlobalSetting.PairsProperties?.Count ?? 0))</h5>
        <input type="hidden" name="MarketAnalyzer_GlobalSetting_@(Model.SettingName)|PairsPropertiesRendered" value="true" />
        <div id="MarketAnalyzer_GlobalSetting_@(Model.SettingName)_PairsProperties"></div>

        <button type="button" id="btn-new-pairs-property-GS@(Model.SettingName)" class="btn btn-ptmagic btn-custom  btn-block text-uppercase waves-effect waves-light m-b-20" data-datatarget="MarketAnalyzer_GlobalSetting_@(Model.SettingName)_PairsProperties">
          Add Property
        </button>

        <hr />

        <h5 class="header-title m-b-20">DCA Properties (@(Model.GlobalSetting.DCAProperties?.Count ?? 0))</h5>
        <input type="hidden" name="MarketAnalyzer_GlobalSetting_@(Model.SettingName)|DCAPropertiesRendered" value="true" />
        <div id="MarketAnalyzer_GlobalSetting_@(Model.SettingName)_DCAProperties"></div>
        <button type="button" id="btn-new-dca-property-GS@(Model.SettingName)" class="btn btn-ptmagic btn-custom  btn-block text-uppercase waves-effect waves-light m-b-20" data-datatarget="MarketAnalyzer_GlobalSetting_@(Model.SettingName)_DCAProperties">
          Add Property
        </button>

        <hr />

        <h5 class="header-title m-b-20">Indicators Properties (@(Model.GlobalSetting.IndicatorsProperties?.Count ?? 0))</h5>
        <input type="hidden" name="MarketAnalyzer_GlobalSetting_@(Model.SettingName)|IndicatorsPropertiesRendered" value="true" />
        <div id="MarketAnalyzer_GlobalSetting_@(Model.SettingName)_IndicatorsProperties"></div>

        <button type="button" id="btn-new-indicators-property-GS@(Model.SettingName)" class="btn btn-ptmagic btn-custom  btn-block text-uppercase waves-effect waves-light m-b-20" data-datatarget="MarketAnalyzer_GlobalSetting_@(Model.SettingName)_IndicatorsProperties">
          Add Property
        </button>

        @if (!Model.IsDefaultSetting) {
          <button type="button" class="btn btn-danger m-t-20 btn-block text-uppercase waves-effect waves-light btn-remove-GS@(Model.SettingName)" data-datatarget="GlobalSetting_@Model.SettingName">
            Remove Global Setting "@Model.GlobalSetting.SettingName"
          </button>
        }
      </div>
    </div>
  </div>
  <script type="text/javascript">
    function BindRemoveParentRow@(Model.SettingName)Event() {
      syncAnalyzerTrendOptions();
      $('.btn-remove-parentrow-GlobalSetting-@(Model.SettingName)').off('click.analyzer').on('click.analyzer', function () {
        $(this).closest('.analyzer-editor-row').find(':input').prop('disabled', true);
        $(this).closest('.analyzer-editor-row').animate({ height: 0 }, 300, function () {
          $(this).remove();
        });

        return false;
      });
    }

    $(document).ready(function () {
      
    $('#MarketAnalyzer_GlobalSetting_@(Model.SettingName)_Triggers').html(@(Html.Raw(AnalyzerSettingsEditor.Json(AnalyzerSettingsEditor.TriggerRows(Model.GlobalSetting.Triggers, Model.PTMagicConfiguration.AnalyzerSettings.MarketAnalyzer.MarketTrends, "GlobalSetting", Model.SettingName, Model.Summary.MainMarket)))).map(AnalyzerTriggerTemplate).join(''));

    $('#MarketAnalyzer_GlobalSetting_@(Model.SettingName)_PairsProperties').html(@(Html.Raw(AnalyzerSettingsEditor.Json(AnalyzerSettingsEditor.PropertyRows(Model.GlobalSetting.PairsProperties, "GlobalSetting", Model.SettingName, "Pairs")))).map(PropertyTemplate).join(''));

    $('#MarketAnalyzer_GlobalSetting_@(Model.SettingName)_DCAProperties').html(@(Html.Raw(AnalyzerSettingsEditor.Json(AnalyzerSettingsEditor.PropertyRows(Model.GlobalSetting.DCAProperties, "GlobalSetting", Model.SettingName, "DCA")))).map(PropertyTemplate).join(''));

    $('#MarketAnalyzer_GlobalSetting_@(Model.SettingName)_IndicatorsProperties').html(@(Html.Raw(AnalyzerSettingsEditor.Json(AnalyzerSettingsEditor.PropertyRows(Model.GlobalSetting.IndicatorsProperties, "GlobalSetting", Model.SettingName, "Indicators")))).map(PropertyTemplate).join(''));

    $('#btn-new-standardtrigger-GS@(Model.SettingName)').click(function () {
      var dataTarget = $(this).data('datatarget');
      $('#' + dataTarget).append([{ settingType: 'GlobalSetting', settingName: '@(Model.SettingName)', trendName: '', minChange: '', maxChange: '', marketTrends: @Html.Raw(AnalyzerSettingsEditor.Json(Model.GetMarketTrendSelection(null))) }].map(GSStandardTriggerTemplate).join(''));
      $(document).ready(function () { BindRemoveParentRow@(Model.SettingName)Event(); });
      return false;
    });

    $('#btn-new-pairs-property-GS@(Model.SettingName)').click(function () {
      var dataTarget = $(this).data('datatarget');
      $('#' + dataTarget).append([{ settingType: 'GlobalSetting', settingName: '@(Model.SettingName)', propertyType: 'Pairs', propertyKeySimple: '', value: '', valueModes: @Html.Raw(AnalyzerSettingsEditor.Json(Model.GetValueModes(""))) }].map(PropertyTemplate).join(''));
      $(document).ready(function () { BindRemoveParentRow@(Model.SettingName)Event(); });
      return false;
    });

    $('#btn-new-dca-property-GS@(Model.SettingName)').click(function () {
      var dataTarget = $(this).data('datatarget');
      $('#' + dataTarget).append([{ settingType: 'GlobalSetting', settingName: '@(Model.SettingName)', propertyType: 'DCA', propertyKeySimple: '', value: '', valueModes: @Html.Raw(AnalyzerSettingsEditor.Json(Model.GetValueModes(""))) }].map(PropertyTemplate).join(''));
      $(document).ready(function () { BindRemoveParentRow@(Model.SettingName)Event(); });
      return false;
    });

    $('#btn-new-indicators-property-GS@(Model.SettingName)').click(function () {
      var dataTarget = $(this).data('datatarget');
      $('#' + dataTarget).append([{ settingType: 'GlobalSetting', settingName: '@(Model.SettingName)', propertyType: 'Indicators', propertyKeySimple: '', value: '', valueModes: @Html.Raw(AnalyzerSettingsEditor.Json(Model.GetValueModes(""))) }].map(PropertyTemplate).join(''));
      $(document).ready(function () { BindRemoveParentRow@(Model.SettingName)Event(); });
      return false;
    });

    $('.btn-remove-GS@(Model.SettingName)').click(function () {
      var dataTarget = $(this).data('datatarget');

      $('#' + dataTarget).find(':input').prop('disabled', true);
      $('#' + dataTarget).animate({ height: 0 }, 300, function () {
        $(this).closest('.settings-globalsetting').remove();
      });

      return false;
    });

    $('.btn-move-GS@(Model.SettingName)').click(function () {
      checkedGSButtons = false;
      var dataTarget = $(this).data('datatarget');
      var dataDirection = $(this).data('datadirection');

      var currentElement = $('#' + dataTarget).closest('.settings-globalsetting');

      var prevElement = $(currentElement).prev('.settings-globalsetting');
      var nextElement = $(currentElement).next('.settings-globalsetting');

      if (dataDirection === 'down') {
        $(currentElement).insertAfter($(nextElement));
        $('html, body').scrollTop($(currentElement).offset().top - 100);
      } else if (dataDirection === 'up') {
        $(currentElement).insertBefore($(prevElement));
        $('html, body').scrollTop($(currentElement).offset().top - 100);
      }
      checkGSMoveButtons();

      return false;
    });

    BindRemoveParentRow@(Model.SettingName)Event();
  });
  </script>
</div>
