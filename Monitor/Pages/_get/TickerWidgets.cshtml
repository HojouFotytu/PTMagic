@page
@model TickerWidgetsModel
@{
  Layout = null;

  int activeSingleSettings = Model.MarketsWithSingleSettings.Count;
  string singleSettingsInfoClass = "fa fa-info-circle text-muted";
  string singleSettingsTooltip = "";
  if (activeSingleSettings > 0) {
    singleSettingsTooltip = "<b>Single Market Settings active for:</b><br />" + Core.Helper.SystemHelper.ConvertListToTokenString(Model.MarketsWithSingleSettings, "<br />", true);
  } else {
    singleSettingsInfoClass += " d-none";
  }

  string globalIconColor = "text-success";
  if (Model.PTData.Properties.Shorting) {
    globalIconColor = "text-danger";
  }

  string selectedGlobalSetting = String.IsNullOrWhiteSpace(Model.Summary.DesiredGlobalSettingName)
    ? Model.Summary.CurrentGlobalSetting?.SettingName ?? "Not selected"
    : Model.Summary.DesiredGlobalSettingName;
  bool deliveredToPT = (String.Equals(Model.Summary.ConfigurationDeliveryStatus, "Applied", StringComparison.OrdinalIgnoreCase)
      || String.Equals(Model.Summary.ConfigurationDeliveryStatus, "Unchanged", StringComparison.OrdinalIgnoreCase))
    && !String.IsNullOrWhiteSpace(Model.Summary.AppliedGlobalSettingName)
    && String.Equals(Model.Summary.AppliedGlobalSettingName, selectedGlobalSetting, StringComparison.OrdinalIgnoreCase);

  // Only the four requested compact lines; absent SOM is not listed.
  // StartupSellOnlyModeActive records PTMagic's acknowledged enable, not
  // a live ProfitTrailer SOM readback.
  string globalSettingInfoTooltip = System.Net.WebUtility.HtmlEncode(Model.PTMagicConfiguration.GeneralSettings.Application.InstanceName)
    + "<br />" + System.Net.WebUtility.HtmlEncode(selectedGlobalSetting)
    + "<br />" + (deliveredToPT ? "Delivered to PT" : "Not Delivered to PT");
  if (Model.Summary.StartupSellOnlyModeActive)
    globalSettingInfoTooltip += "<br />Startup SOM";

  DateTime lastRuntime = Model.Summary.LastRuntime;
  double elapsedSecondsSinceRuntime = DateTime.UtcNow.Subtract(lastRuntime).TotalSeconds;
  double intervalSeconds = Model.PTMagicConfiguration.AnalyzerSettings.MarketAnalyzer.IntervalMinutes * 60.0;

  string healthIconColor = "text-success";
  string ptMagicHealthIcon = "fa-heartbeat";
  string ptMagicHealthTooltip = "PT Magic is alive and healthy! Time elapsed since last run:  " + Math.Round(elapsedSecondsSinceRuntime / 60, 1) + " mins.";
  if (elapsedSecondsSinceRuntime > (intervalSeconds * 2)) {
    ptMagicHealthIcon = "fa-exclamation-triangle";
    ptMagicHealthTooltip = "PT Magic seems to have problems, check the logs!  Time elapsed since last run:  " + Math.Round(elapsedSecondsSinceRuntime / 60, 1) + " mins.";
    healthIconColor = "text-danger";
  }
  if (Model.IsAnalyzerRunning()) {
    ptMagicHealthIcon = "fa-cog fa-spin";
  }
  if (String.Equals(Model.Summary.ConfigurationDeliveryStatus, "Failed", StringComparison.OrdinalIgnoreCase)
    || String.Equals(Model.Summary.ConfigurationDeliveryStatus, "Deferred", StringComparison.OrdinalIgnoreCase)
    || Model.Summary.StartupSellOnlyModePending) {
    healthIconColor = "text-warning";
    ptMagicHealthIcon = "fa-exclamation-triangle";
    ptMagicHealthTooltip = "Configuration delivery: " + Model.Summary.ConfigurationDeliveryStatus + "; startup global SOM: " + Model.Summary.StartupSellOnlyModeStatus + ". Check Status Summary and the logs.";
  }
}

<div class="card-box card-box-mini card-box-ptmagic-outlined @globalIconColor" data-ticker-role="global-card">
  <span data-ticker-role="global-setting" data-toggle="tooltip" data-placement="bottom" title="Selected global setting; see details for confirmed delivery">Selected: @Core.Helper.SystemHelper.SplitCamelCase(String.IsNullOrEmpty(Model.Summary.DesiredGlobalSettingName) ? Model.Summary.CurrentGlobalSetting?.SettingName ?? "Not selected" : Model.Summary.DesiredGlobalSettingName)</span><span class="header-title"><a href="StatusSummary"> <i data-ticker-role="global-info" class="fa fa-info-circle text-muted" data-toggle="tooltip" data-placement="top" data-html="true" title="@Html.Raw(globalSettingInfoTooltip)" data-template="<div class='tooltip' role='tooltip'><div class='tooltip-arrow'></div><div class='tooltip-inner tooltip-global-setting text-left'></div></div>"></i></a></span>
</div>

<div class="card-box card-box-mini card-box-ptmagic-outlined" data-ticker-role="sms-card">
  <span data-toggle="tooltip" data-placement="bottom" title="Active single market settings"><b>SMS: </b></span><span class="header-title"><a href="ManageSMS"><span data-ticker-role="sms-count">@activeSingleSettings</span> <i data-ticker-role="sms-info" class="@singleSettingsInfoClass" data-toggle="tooltip" data-placement="top" data-html="true" title="@Html.Raw(singleSettingsTooltip)" data-template="<div class='tooltip' role='tooltip'><div class='tooltip-arrow'></div><div class='tooltip-inner tooltip-200 text-left'></div></div>"></i></a></span>
</div>

@if (Model.Summary.StartupSellOnlyModeNoticeVisible)
{
  <div class="card-box card-box-mini card-box-ptmagic-outlined text-danger" data-ticker-role="som-card">
    <span class="text-danger"><b>PT: SOM</b></span>
    <i class="fa fa-info-circle text-danger" data-ticker-role="som-info"
      data-toggle="tooltip" data-placement="bottom"
      title="PTMagic requested global Sell Only Mode ON during startup protection. It never turns SOM OFF automatically. New buys and DCA buys can remain blocked; sells continue. Open ProfitTrailer and manually disable SOM when ready. This indicator appears during startup raids 1 and 2 only and does not read the live PT SOM flag."></i>
  </div>
}

<div class="card-box card-box-mini card-box-ptmagic-status-outlined @healthIconColor" data-ticker-role="health-card" data-toggle="tooltip" data-placement="bottom" title="@ptMagicHealthTooltip">
  <i data-ticker-role="health-icon" class="fa @ptMagicHealthIcon @healthIconColor"></i>
</div>
