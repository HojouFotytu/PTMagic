@section Styles {
  <link href="@Html.Raw(Model.PTMagicConfiguration.GeneralSettings.Monitor.RootUrl)assets/plugins/tablesaw/css/tablesaw.css" rel="stylesheet" type="text/css" />
  <link href="@Html.Raw(Model.PTMagicConfiguration.GeneralSettings.Monitor.RootUrl)assets/plugins/nvd3/nv.d3.min.css" rel="stylesheet" type="text/css" />
  <style>
    .market-wide-grouped th,
    .market-wide-grouped td,
    .market-wide-grouped .market-wide-group-heading,
    .market-wide-grouped .market-wide-group-line {
      text-align: center !important;
      vertical-align: middle !important;
    }
    .market-wide-grouped th.market-wide-group,
    .market-wide-grouped td.market-wide-group {
      min-width: 145px;
      white-space: nowrap;
    }
    .market-wide-grouped .market-wide-group-heading {
      display: block;
      width: 100%;
      color: #ffffff !important;
      text-transform: uppercase !important;
      font-weight: 700 !important;
      letter-spacing: 0.03em;
      white-space: nowrap;
    }
    .market-wide-grouped thead .market-wide-subheadings .market-wide-group-line {
      display: block;
      width: 100%;
      color: #8f9fb3 !important;
      font-weight: 400 !important;
      white-space: nowrap;
    }
    .market-wide-grouped .market-wide-group-line {
      display: block;
      width: 100%;
      min-height: 20px;
      line-height: 20px;
      white-space: nowrap;
    }
    /* Asset metrics remain invisible until expanded inside an existing market row. */
    .asset-metric-toggle {
      padding: 0 6px 0 0;
      border: 0;
      background: transparent;
      color: inherit;
      cursor: pointer;
    }
    .asset-metric-toggle:focus { outline: 1px dotted currentColor; }
    .asset-metric-detail-row td { padding-top: 3px; padding-bottom: 3px; font-size: 0.9em; }
    .asset-metric-detail-row .asset-metric-label { padding-left: 22px; }
  </style>
}
