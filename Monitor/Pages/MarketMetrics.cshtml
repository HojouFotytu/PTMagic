@page
@using System
@using System.Collections.Generic
@using System.Linq
@model MarketMetricsModel
@{
  ViewData["Title"] = "Market Metrics";
  List<Core.MarketAnalyzer.MarketData.MarketTrendAnalyticsMonitorTrend> trends = Model.OrderedTrends().ToList();
  List<string> markets = Model.OrderedMarkets().ToList();
}

@section Styles {
  <link href="@Html.Raw(Model.PTMagicConfiguration.GeneralSettings.Monitor.RootUrl)assets/plugins/tablesaw/css/tablesaw.css" rel="stylesheet" type="text/css" />
}

<div class="row">
  <div class="col-sm-12">
    <div class="card-box">
      <h4 class="m-t-0 m-b-10 header-title"><b>Market Metrics</b></h4>
      <p class="text-muted m-b-20">
        Read-only Phase 1 analytics generated by the PTMagic Analyzer from the Metrics enabled on each Exchange MarketTrend.
      </p>

      @if (!String.IsNullOrWhiteSpace(Model.LoadError))
      {
        <div class="alert alert-warning">@Model.LoadError</div>
      }
      else
      {
        <div class="row">
          <div class="col-md-4">
            <strong>Snapshot</strong><br />
            @Model.Analytics.TimestampUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
          </div>
          <div class="col-md-4">
            <strong>Metric-Enabled Trends</strong><br />
            @trends.Count
          </div>
          <div class="col-md-4">
            <strong>Markets with Per-Market Metrics</strong><br />
            @markets.Count
          </div>
        </div>
      }
    </div>
  </div>
</div>

@if (String.IsNullOrWhiteSpace(Model.LoadError))
{
  <div class="row">
    <div class="col-sm-12">
      <div class="card-box">
        <h4 class="m-t-0 m-b-10 header-title"><b>History Requirements</b></h4>
        <p class="text-muted">Required history depends on each metric, timeframe and lookback. OHLCV retention uses StoreDataMaxHours; derivatives history is derived from enabled MarketTrends separately. Sufficient capacity never guarantees that the exchange has provided the observations.</p>
        <div class="table-responsive">
          <table class="table table-sm">
            <thead><tr><th>Trend / metric</th><th>Calculation basis</th><th class="text-right">Closed source candles</th><th class="text-right">Required now</th><th class="text-right">Recommended retention</th><th class="text-right">Configured</th><th>Status</th></tr></thead>
            <tbody>
              @foreach (var trend in trends) {
                @foreach (var requirement in trend.HistoryRequirements ?? new List<Core.MarketAnalyzer.MarketData.MarketTrendHistoryRequirement>()) {
                  <tr class="@(requirement.HasAllAlignmentCapacity == false ? "text-warning" : "")">
                    <td>@trend.Name / @Model.MetricTitle(requirement.Metric)</td>
                    <td>@requirement.Basis</td>
                    <td class="text-right">@(requirement.SourceDataFamily == "BinanceFuturesOpenInterest" ? "2 OI endpoints" : requirement.MinimumClosedSourceCandles.ToString())</td>
                    <td class="text-right">@(requirement.SourceDataFamily == "BinanceFuturesOpenInterest" ? (requirement.CalculationWindowMinutes / 60.0).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + " h" : requirement.RequiredStoreDataMaxHours + " h")</td>
                    <td class="text-right">@(requirement.SourceDataFamily == "BinanceFuturesOpenInterest" ? "MarketTrend-derived" : requirement.RecommendedStoreDataMaxHours + " h")</td>
                    <td class="text-right">@(requirement.SourceDataFamily == "BinanceFuturesOpenInterest" ? "Automatic" : requirement.ConfiguredStoreDataMaxHours.HasValue ? requirement.ConfiguredStoreDataMaxHours.Value + " h" : "--")</td>
                    <td>@(requirement.SourceDataFamily == "BinanceFuturesOpenInterest" ? "Provider availability and exact endpoints required" : String.IsNullOrEmpty(requirement.Diagnostic) ? "Capacity sufficient" : requirement.Diagnostic)</td>
                  </tr>
                }
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-sm-12">
      <div class="card-box">
        <h4 class="m-t-0 m-b-20 header-title"><b>Market-Wide Metrics</b></h4>
        <div class="table-responsive">
          <table class="table table-sm m-b-0">
            <thead>
              <tr>
                <th>Trend</th>
                <th class="text-right">Timeframe</th>
                <th class="text-right">Markets</th>
                @foreach (string metric in Model.GlobalMetricNames)
                {
                  <th class="text-right" data-toggle="tooltip" data-placement="top" title="@Model.MetricTooltip(metric)">@Model.MetricTitle(metric)</th>
                }
              </tr>
            </thead>
            <tbody>
              @foreach (Core.MarketAnalyzer.MarketData.MarketTrendAnalyticsMonitorTrend trend in trends)
              {
                <tr>
                  <td>@Core.Helper.SystemHelper.SplitCamelCase(trend.Name)</td>
                  <td class="text-right">@Model.FormatTimeframe(trend.TrendMinutes)</td>
                  <td class="text-right">@trend.GlobalSymbols.Count</td>
                  @foreach (string metric in Model.GlobalMetricNames)
                  {
                    Core.MarketAnalyzer.MarketData.FeatureValueSnapshot feature = Model.GetGlobalMetric(trend, metric);
                    <td class="text-right text-autocolor" data-toggle="tooltip" data-placement="top" title="@Model.FeatureTooltip(feature)">
                      @Model.FormatMetric(metric, feature)
                    </td>
                  }
                </tr>
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <div class="row">
    <div class="col-sm-12">
      <div class="card-box">
        <h4 class="m-t-0 m-b-10 header-title"><b>Per-Market Metrics</b></h4>
        <p class="text-muted m-b-20">
          Includes relative strength, ATRP, and quote-volume expansion on the configured MarketTrend timeframe. Hover column headings for definitions.
        </p>

        @if (markets.Count == 0)
        {
          <div class="alert alert-info">No asset-scoped metrics are enabled in the current MarketTrend configuration.</div>
        }
        else
        {
          <div class="table-responsive">
            <table class="tablesaw table m-b-0" data-tablesaw-sortable data-tablesaw-sortable-switch>
              <thead>
                <tr>
                  <th scope="col" data-tablesaw-priority="persist" data-tablesaw-sortable-col data-tablesaw-sortable-default-col>Market</th>
                  @foreach (Core.MarketAnalyzer.MarketData.MarketTrendAnalyticsMonitorTrend trend in trends)
                  {
                    foreach (string metric in Model.AssetMetricNames)
                    {
                      <th scope="col" data-tablesaw-sortable-col class="text-right" data-toggle="tooltip" data-placement="top" title="@Model.MetricTooltip(metric)">
                        @Core.Helper.SystemHelper.SplitCamelCase(trend.Name) @Model.MetricTitle(metric)
                      </th>
                    }
                  }
                </tr>
              </thead>
              <tbody>
                @foreach (string market in markets)
                {
                  <tr>
                    <th>@market</th>
                    @foreach (Core.MarketAnalyzer.MarketData.MarketTrendAnalyticsMonitorTrend trend in trends)
                    {
                      foreach (string metric in Model.AssetMetricNames)
                      {
                        Core.MarketAnalyzer.MarketData.FeatureValueSnapshot feature = Model.GetAssetMetric(trend, market, metric);
                        <td class="text-right text-autocolor-saw" data-toggle="tooltip" data-placement="top" title="@Model.FeatureTooltip(feature)">
                          @Model.FormatMetric(metric, feature)
                        </td>
                      }
                    }
                  </tr>
                }
              </tbody>
            </table>
          </div>
        }
      </div>
    </div>
  </div>
}

@section Scripts {
  <script src="@Html.Raw(Model.PTMagicConfiguration.GeneralSettings.Monitor.RootUrl)assets/plugins/tablesaw/js/tablesaw.js"></script>
  <script src="@Html.Raw(Model.PTMagicConfiguration.GeneralSettings.Monitor.RootUrl)assets/plugins/tablesaw/js/tablesaw-init.js"></script>
}
