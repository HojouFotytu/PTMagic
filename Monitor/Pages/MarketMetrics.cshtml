@page
@model MarketMetricsModel
@{
  ViewData["Title"] = "Market Metrics";
}

<div class="row">
  <div class="col-sm-12">
    <div class="card-box">
      <h4 class="m-t-0 m-b-10 header-title"><b>Market Metrics</b></h4>
      <p class="m-b-20">
        Market-wide metrics are now displayed on the main Market Analyzer page. The per-market metrics view has been removed.
      </p>
      <a class="btn btn-ptmagic waves-effect waves-light" href="@Html.Raw(Model.PTMagicConfiguration.GeneralSettings.Monitor.RootUrl)MarketAnalyzer">
        Open Market Analyzer
      </a>
    </div>
  </div>
</div>
