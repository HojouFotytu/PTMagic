@page
@model Monitor.Pages.LogsModel
@{
  ViewData["Title"] = "Logs";
}
<div class="row">
  <div class="col-md-12">
    <div class="card-box">
      <h4 class="m-t-0 header-title">Live Logs</h4>
      <p>Read the Analyzer and Monitor application logs as they are written. Only recent entries are retained in this browser. The viewer does not change application logging or trading settings.</p>
      @if (!Model.LogsEnabled)
      {
        <div class="alert alert-warning">For security, live log viewing requires a password-protected Monitor. Configure a Monitor password to enable this page.</div>
      }
      else
      {
        <div class="form-row align-items-end mb-3">
          <div class="form-group col-md-3">
            <label for="log-source">Application</label>
            <select class="form-control" id="log-source">
              <option value="analyzer">Analyzer (PTMagic)</option>
              <option value="monitor">Monitor</option>
            </select>
          </div>
          <div class="form-group col-md-2">
            <label for="log-level">Severity</label>
            <select class="form-control" id="log-level">
              <option value="">All levels</option>
              <option value="TRACE">TRACE</option>
              <option value="DEBUG">DEBUG</option>
              <option value="INFO">INFO</option>
              <option value="WARN">WARN</option>
              <option value="ERROR">ERROR</option>
              <option value="FATAL">FATAL</option>
            </select>
          </div>
          <div class="form-group col-md-4">
            <label for="log-search">Search loaded lines</label>
            <input id="log-search" class="form-control" type="search" placeholder="Search log text" />
          </div>
          <div class="form-group col-md-3">
            <button id="log-toggle" class="btn btn-ptmagic" type="button"><i class="fa fa-pause"></i> Pause</button>
            <button id="log-clear" class="btn btn-secondary" type="button">Clear</button>
          </div>
        </div>
        <div class="d-flex align-items-center justify-content-between mb-2">
          <div>
            <label class="mb-0"><input type="checkbox" id="log-autoscroll" checked /> Auto-scroll</label>
            <span id="log-status" class="ml-3 text-muted" role="status" aria-live="polite">Connecting...</span>
          </div>
          <span class="text-muted">Live streaming</span>
        </div>
        <div id="log-monitor-issues" style="background:#231d1e;color:#f1d4d4;padding:10px;margin-bottom:8px;font:12px/1.6 Consolas,Monaco,monospace;white-space:pre-wrap;overflow-wrap:anywhere;" hidden>
          <strong>Recent Monitor warnings and errors</strong>
          <div id="log-monitor-issue-lines" style="max-height:220px;overflow:auto;margin-top:5px;"></div>
        </div>
        <div id="log-previous" style="background:#18222d;color:#dde4eb;padding:10px;margin-bottom:8px;font:12px/1.6 Consolas,Monaco,monospace;white-space:pre-wrap;overflow-wrap:anywhere;" hidden>
          <strong>Previous raid summary</strong>
          <div id="log-previous-lines"></div>
        </div>
        <button id="log-older" class="btn btn-sm btn-secondary mb-2" type="button" hidden>Show earlier current-raid lines</button>
        <div id="log-output" role="log" aria-label="Application logs" aria-live="off" tabindex="0"
          style="background:#111820;color:#dde4eb;min-height:380px;max-height:68vh;overflow:auto;padding:12px;font:12px/1.6 Consolas,Monaco,monospace;white-space:pre-wrap;overflow-wrap:anywhere;"></div>
      }
    </div>
  </div>
</div>
@section Scripts {
@if (Model.LogsEnabled)
{
<script type="text/javascript">
(function () {
  'use strict';
  var root = '@Html.Raw(Model.PTMagicConfiguration.GeneralSettings.Monitor.RootUrl)';
  var source = document.getElementById('log-source');
  var level = document.getElementById('log-level');
  var search = document.getElementById('log-search');
  var output = document.getElementById('log-output');
  var monitorIssuesPanel = document.getElementById('log-monitor-issues');
  var monitorIssueLines = document.getElementById('log-monitor-issue-lines');
  var monitorIssues = [];
  var maxMonitorIssues = 200;
  var previousPanel = document.getElementById('log-previous');
  var previousLines = document.getElementById('log-previous-lines');
  var olderButton = document.getElementById('log-older');
  var status = document.getElementById('log-status');
  var toggle = document.getElementById('log-toggle');
  var clear = document.getElementById('log-clear');
  var autoScroll = document.getElementById('log-autoscroll');
  var maxLines = 500; // Monitor only; Analyzer retains the entire current raid in memory.
  var previousRaidSummary = [];
  var completedRaidSummary = [];
  var collectingSummary = false;
  var analyzerRaidStarted = false;
  var displayLimit = 500;
  var history = { analyzer: [], monitor: [] };
  var cursors = {
    analyzer: { cursor: '', offset: -1 },
    monitor: { cursor: '', offset: -1 }
  };
  var stream = null;
  var paused = false;
  var pending = [];
  var frame = null;
  var reconnectTimer = null;
  var generation = 0;

  function matches(line) {
    var selected = level.value;
    var found = /\b(TRACE|DEBUG|INFO|WARN|ERROR|FATAL)\s*-/.exec(line);
    if (selected && (!found || found[1] !== selected)) return false;
    return line.toLowerCase().indexOf(search.value.toLowerCase()) !== -1;
  }

  function createEntry(line) {
    var item = document.createElement('div');
    item.textContent = line;
    if (/\b(ERROR|FATAL)\s*-/.test(line)) item.style.color = '#ff8080';
    else if (/\bWARN\s*-/.test(line)) item.style.color = '#ffcc70';
    else if (/\bDEBUG\s*-/.test(line)) item.style.color = '#a8b8c7';
    return item;
  }

  function append(lines) {
    var frag = document.createDocumentFragment();
    for (var i = 0; i < lines.length; i++) {
      if (matches(lines[i])) frag.appendChild(createEntry(lines[i]));
    }
    output.appendChild(frag);
    while (output.childNodes.length > displayLimit) output.removeChild(output.firstChild);
    if (autoScroll.checked) output.scrollTop = output.scrollHeight;
  }

  function isMonitorIssue(line) {
    return /\b(WARN|ERROR|FATAL|CRITICAL)\s*-/.test(line);
  }

  function renderMonitorIssues() {
    var visible = source.value === 'monitor' && monitorIssues.length > 0;
    monitorIssuesPanel.hidden = !visible;
    if (!visible) { monitorIssueLines.replaceChildren(); return; }
    var fragment = document.createDocumentFragment();
    monitorIssues.filter(matches).forEach(function (line) {
      fragment.appendChild(createEntry(line));
    });
    monitorIssueLines.replaceChildren(fragment);
  }

  function acceptMonitorLines(lines) {
    for (var i = 0; i < lines.length; i++) {
      if (isMonitorIssue(lines[i])) monitorIssues.push(lines[i]);
    }
    if (monitorIssues.length > maxMonitorIssues)
      monitorIssues.splice(0, monitorIssues.length - maxMonitorIssues);
    if (lines.some(isMonitorIssue)) renderMonitorIssues();
  }

  function renderPrevious() {
    var visible = source.value === 'analyzer' && previousRaidSummary.length > 0;
    previousPanel.hidden = !visible;
    if (!visible) { previousLines.replaceChildren(); return; }
    var fragment = document.createDocumentFragment();
    previousRaidSummary.filter(matches).forEach(function (line) {
      fragment.appendChild(createEntry(line));
    });
    previousLines.replaceChildren(fragment);
  }

  function updateOlderButton() {
    var count = history[source.value].filter(matches).length;
    olderButton.hidden = source.value !== 'analyzer' || count <= displayLimit;
    if (!olderButton.hidden) olderButton.textContent = 'Show earlier current-raid lines (' + (count - displayLimit) + ' hidden)';
  }

  function render() {
    var lines = history[source.value].filter(matches).slice(-displayLimit);
    output.replaceChildren();
    append(lines);
    renderPrevious();
    renderMonitorIssues();
    updateOlderButton();
  }

  function flush() {
    frame = null;
    if (!pending.length) return;
    var batch = pending.splice(0);
    append(batch);
    updateOlderButton();
  }

  function scheduleRender(lines) {
    Array.prototype.push.apply(pending, lines);
    if (pending.length > maxLines) pending.splice(0, pending.length - maxLines);
    if (frame === null) frame = requestAnimationFrame(flush);
  }

  function handleAnalyzerLines(lines) {
    var fresh = [];
    var resetView = false;
    for (var i = 0; i < lines.length; i++) {
      var line = lines[i];
      if (line.indexOf('Starting market trend check with Version ') !== -1) {
        if (completedRaidSummary.length) previousRaidSummary = completedRaidSummary.slice();
        completedRaidSummary = [];
        collectingSummary = false;
        analyzerRaidStarted = true;
        history.analyzer = [];
        displayLimit = 500;
        resetView = true;
      }
      if (line.indexOf('RAID SUMMARY') !== -1) {
        completedRaidSummary = [];
        collectingSummary = true;
      }
      if (collectingSummary) {
        completedRaidSummary.push(line);
        if (line.indexOf('DO NOT CLOSE THIS WINDOW! THIS IS THE BOT THAT ANALYZES TRENDS AND CHANGES SETTINGS!') !== -1)
          collectingSummary = false;
      }
      // Nothing before the next raid start is replayed after the initial summary.
      if (analyzerRaidStarted) {
        history.analyzer.push(line);
        fresh.push(line);
      }
    }
    if (resetView) {
      pending.length = 0;
      if (frame !== null) { cancelAnimationFrame(frame); frame = null; }
      render();
    } else if (fresh.length) scheduleRender(fresh);
  }

  function closeStream() {
    generation++;
    clearTimeout(reconnectTimer);
    if (stream) { stream.close(); stream = null; }
    pending.length = 0;
    if (frame !== null) { cancelAnimationFrame(frame); frame = null; }
  }

  function connect() {
    closeStream();
    if (paused || document.hidden) return;
    var key = source.value;
    var current = generation;
    var state = cursors[key];
    var url = root + 'Logs?handler=Stream&source=' + encodeURIComponent(key)
      + '&cursor=' + encodeURIComponent(state.cursor)
      + '&offset=' + encodeURIComponent(state.offset);
    status.textContent = 'Connecting...';
    stream = new EventSource(url);
    stream.onopen = function () {
      if (generation === current) status.textContent = 'Live';
    };
    stream.addEventListener("snapshot", function (event) {
      if (generation !== current || key !== "analyzer") return;
      try {
        var data = JSON.parse(event.data);
        previousRaidSummary = Array.isArray(data.lines) ? data.lines : [];
        render();
      } catch (error) { status.textContent = "Summary unavailable"; }
    });
    stream.addEventListener('monitor-snapshot', function (event) {
      if (generation !== current || key !== 'monitor') return;
      try {
        var data = JSON.parse(event.data);
        history.monitor = Array.isArray(data.recent) ? data.recent.slice(-maxLines) : [];
        monitorIssues = Array.isArray(data.issues) ? data.issues.slice(-maxMonitorIssues) : [];
        render();
      } catch (error) { status.textContent = 'Monitor history unavailable'; }
    });
    stream.onmessage = function (event) {
      if (generation !== current) return;
      var data;
      try { data = JSON.parse(event.data); } catch (error) { return; }
      if (data.reset) {
        // Preserve prior Monitor diagnostics across daily log rotation.
        pending.length = 0;
        if (frame !== null) { cancelAnimationFrame(frame); frame = null; }
        if (key === "monitor") output.replaceChildren();
      }
      state.cursor = data.cursor || '';
      state.offset = typeof data.offset === 'number' ? data.offset : -1;
      var lines = Array.isArray(data.lines) ? data.lines : [];
      if (!lines.length) return;
      if (key === "analyzer") handleAnalyzerLines(lines);
      else {
        acceptMonitorLines(lines);
        Array.prototype.push.apply(history[key], lines);
        if (history[key].length > maxLines)
          history[key].splice(0, history[key].length - maxLines);
        scheduleRender(lines);
      }
    };
    stream.onerror = function () {
      if (generation !== current) return;
      status.textContent = 'Disconnected; reconnecting...';
      // EventSource reconnects automatically, resuming from the last cursor.
      // Resume is idempotent only for a fresh connection with current offset.
      closeStream();
      if (!paused && !document.hidden) reconnectTimer = setTimeout(connect, 1000);
    };
  }

  source.addEventListener('change', function () { displayLimit = 500; render(); connect(); });
  olderButton.addEventListener('click', function () {
    displayLimit += 500;
    render();
  });
  level.addEventListener('change', function () {
    pending.length = 0;
    if (frame !== null) { cancelAnimationFrame(frame); frame = null; }
    render();
  });
  search.addEventListener('input', function () {
    pending.length = 0;
    if (frame !== null) { cancelAnimationFrame(frame); frame = null; }
    render();
  });
  clear.addEventListener('click', function () {
    history[source.value] = [];
    if (source.value === "analyzer") { previousRaidSummary = []; completedRaidSummary = []; }
    else monitorIssues = [];
    renderPrevious();
    renderMonitorIssues();
    updateOlderButton();
    pending.length = 0;
    if (frame !== null) { cancelAnimationFrame(frame); frame = null; }
    output.replaceChildren();
  });
  toggle.addEventListener('click', function () {
    paused = !paused;
    toggle.innerHTML = paused ? '<i class="fa fa-play"></i> Resume' : '<i class="fa fa-pause"></i> Pause';
    if (paused) {
      closeStream();
      status.textContent = 'Paused';
    } else connect();
  });
  document.addEventListener('visibilitychange', function () {
    if (document.hidden) closeStream();
    else if (!paused) connect();
  });
  window.addEventListener('pagehide', closeStream);
  connect();
})();
</script>
}
}
