<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
    <PackageReference Include="NLog" Version="4.6.8" />
    <PackageReference Include="NLog.Extensions.Logging" Version="1.6.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="SharpZipLib" Version="*" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.4" />
    <PackageReference Include="Telegram.Bot" Version="22.10.3.3" />
  </ItemGroup>

  <Target Name="GeneratePTMSourceRevision" BeforeTargets="CoreCompile">
    <Exec Command="git log -1 --format=%ct" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="Low" StandardErrorImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="PTMCommitUnixSecondsOutput" />
    </Exec>
    <Exec Command="git rev-parse HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="Low" StandardErrorImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="PTMSourceRevisionOutput" />
    </Exec>
    <Exec Command="git status --porcelain --untracked-files=normal" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="Low" StandardErrorImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="PTMSourceStatusOutput" />
    </Exec>
    <PropertyGroup>
      <PTMSourceRevision Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(PTMSourceRevisionOutput)', '^[0-9a-fA-F]{40}$'))">$(PTMSourceRevisionOutput)</PTMSourceRevision>
      <PTMSourceRevision Condition="'$(PTMSourceRevision)' == ''">unknown</PTMSourceRevision>
      <PTMSourceRevision Condition="'$(PTMSourceRevision)' != 'unknown' and '$(PTMSourceStatusOutput)' != ''">$(PTMSourceRevision)-dirty</PTMSourceRevision>
      <PTMCommitUnixSeconds Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(PTMCommitUnixSecondsOutput)', '^[0-9]{9,11}$'))">$(PTMCommitUnixSecondsOutput)</PTMCommitUnixSeconds>
      <PTMCommitUnixSeconds Condition="'$(PTMCommitUnixSeconds)' == ''">unknown</PTMCommitUnixSeconds>
    </PropertyGroup>
    <ItemGroup>
      <PTMBuildAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>PTMSourceRevision</_Parameter1>
        <_Parameter2>$(PTMSourceRevision)</_Parameter2>
      </PTMBuildAttribute>
      <PTMBuildAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>PTMCommitUnixSeconds</_Parameter1>
        <_Parameter2>$(PTMCommitUnixSeconds)</_Parameter2>
      </PTMBuildAttribute>
    </ItemGroup>
    <WriteCodeFragment Language="C#" OutputFile="$(IntermediateOutputPath)PTMSourceRevision.g.cs" AssemblyAttributes="@(PTMBuildAttribute)" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)PTMSourceRevision.g.cs" /></ItemGroup>
  </Target>

</Project>
