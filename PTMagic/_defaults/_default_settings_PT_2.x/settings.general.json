// PTMagic example general settings | Updated: 2026-11-14
// Configure your ProfitTrailer connection, Monitor, backups, and optional notifications here.
// Replace placeholder values with your own settings; do not publish API tokens or licenses.
// Keep TestMode enabled until you have confirmed your configuration behaves as intended.
{
  "GeneralSettings": {
    "Application": {
      "IsEnabled": true, // Enable the PTMagic analyzer (restart required after changing this)
      "TestMode": true, // Evaluate settings without writing changes to ProfitTrailer
      "EnableBetaFeatures": false, // Allow optional beta features when available; keep false for normal operation
      "ProfitTrailerLicense": "", // ProfitTrailer license used for settings integration
      "ProfitTrailerLicenseXtra": "", // Optional comma-separated licenses for additional ProfitTrailer instances
      "ProfitTrailerServerAPIToken": "", // API token for the PT instance; do not commit real credentials
      "ProfitTrailerMonitorURL": "http://localhost:8081/", // ProfitTrailer web/API URL; adjust host and port as needed
      "ProfitTrailerMonitorURLXtra": "", // Optional comma-separated URLs for additional ProfitTrailer instances
      "ProfitTrailerDefaultSettingName": "default", // Name of the default preset in ProfitTrailer
      "Exchange": "BinanceFutures", // Exchange configured in ProfitTrailer; change to match your account
       "FloodProtectionMinutes": 0, // Delay repeated global setting switches when trends fluctuate near thresholds
      "InstanceName": "PTMagic", // Display name used in the Monitor and messages; choose a unique name for each instance
      "CoinMarketCapAPIKey": "" // API key for CoinMarketCap data, if that platform is used
    },
    "Monitor": {
      "IsPasswordProtected": true, // Require a password for Monitor access
      "OpenBrowserOnStart": false, // Automatically open the Monitor browser window when starting locally
      "Port": 8080, // Monitor web server port; use a different port for each PTMagic instance
      "AnalyzerChart": "", // By default the chart on the Market Analyzer page will use your market currency against USD.  
                              //You can change that here. (eg., BTCEUR)
      "LiveTCVTimeframeMinutes": 10, // The timeframe for the live TCV chart on the dashboard
      "GraphIntervalMinutes": 60, // The interval for the monitor market trend graph to draw points in minutes
      "GraphMaxTimeframeHours": 24, // This will enable you to define the timeframe that your graph for market trends covers in hours
      "ProfitsMaxTimeframeDays": 30, // This will enable you to define the timeframe for your dashboard profits graph in days
      "DashboardChartsRefreshSeconds": 30, // The refresh interval of your dashboard charts in seconds
      "BagAnalyzerRefreshSeconds": 60,
      "BuyAnalyzerRefreshSeconds": 60,
      "MaxDashboardBuyEntries": 5, // The number of coins in your Possible Buy List on the dashboard.  Set to 0 to hide the list completely
      "MaxDashboardBagEntries": 9999, // The number of coins in your Positions List on the dashboard. 
      "MaxTopMarkets": 20, // The amount of top markets being shown in your Sales Analyzer
      "MaxDailySummaries": 10, // The amount of "Last Days" being shown in your Sales Analyzer
      "MaxDCAPairs": 25, // For DCA calculations in the DCA Analyzer.
      "DefaultDCAMode": "Advanced", // The default DCA mode to use in the DCA Analyzer.  Options are "Simple" or "Advanced"
      "MaxSettingsLogEntries": 500, // The number of entries in the Global Settings Log on the Status & Summary page
      "MaxMonthlySummaries": 10, // The amount of "Last Months" being shown in your Sales Analyzer
      "LinkPlatform": "TradingView", // The platform to which the pair name will link if you click on it
      "TVCustomLayout": "EbSR85R8",  // A TradingView layout to use when clicking on a pair name while using TradingView as your platform
                                     // When saving a custom layout in TV, you will get a URL like this: https://www.tradingview.com/chart/EbSR85R8/
      "TvStudyA": "BB@tv-basicstudies", // See available STUDIES at https://www.tradingview.com/wiki/Widget:TradingView_Widget
      "TvStudyB": "",
      "TvStudyC": "",
      "TvStudyD": ""
    },
    "Backup": {
      "IsEnabled": true, // Save copies of the current property files before settings switches
      "MaxHours": 12 // Number of hours to retain settings backups
    },
    "Telegram": {
      "IsEnabled": false, // Send optional notifications through Telegram
      "BotToken": "", // Token provided by the Telegram bot service; keep private
      "ChatId": 0, // Telegram chat identifier where notifications are sent
      "SilentMode": false // If SilentMode is active, no notification sound or vibration will happen when the bot sends a Telegram message
    }
  }
}