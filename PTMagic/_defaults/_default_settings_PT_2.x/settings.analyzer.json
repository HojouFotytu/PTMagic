// PTMagic 2.9 example settings | Updated: 2026-11-14
// Backward compatible with the 2.9 configuration model (not 2.10 metric triggers).
// Example adjustments in GlobalSettings and SingleMarketSettings are COMMENTS ONLY.
// These are demonstrations, not recommended live-trading thresholds or a strategy.
// Test with Application.TestMode=true before enabling live changes.
{
  "AnalyzerSettings": {
    "MarketAnalyzer": {
      "StoreDataMaxHours": 96, // Longest example trend is 72h; retain some history beyond it.
      "IntervalMinutes": 5,
      "ExcludeMainCurrency": true,
      "UseProfitTrailerEnabledPairs": false, // true: restrict analysis to PT-enabled pairs
      "UseProfitTrailerAllowedUnderlyingTypes": false, // true: read PT allowed_underlying_type
      "IncludedUnderlyingTypes": ["COIN"], // Used when the preceding property is false
      "MarketTrends": [
        {
          "Name": "1h", "Platform": "Exchange", "MaxMarkets": 50,
          "TrendMinutes": 60, "TrendCurrency": "Market", "TrendThreshold": 15,
          "DisplayGraph": true, "DisplayOnMarketAnalyzerList": true,
          "ExcludeMainCurrency": true,
          "IgnoredMarkets": "", "AllowedMarkets": ""
        },
        {
          "Name": "6h", "Platform": "Exchange", "MaxMarkets": 50,
          "TrendMinutes": 360, "TrendCurrency": "Market", "TrendThreshold": 25,
          "DisplayGraph": true, "DisplayOnMarketAnalyzerList": true
        },
        {
          "Name": "24h", "Platform": "Exchange", "MaxMarkets": 50,
          "TrendMinutes": 1440, "TrendCurrency": "Market", "TrendThreshold": 40,
          "DisplayGraph": true, "DisplayOnMarketAnalyzerList": true
        },
        {
          "Name": "72h", "Platform": "Exchange", "MaxMarkets": 50,
          "TrendMinutes": 4320, "TrendCurrency": "Market", "TrendThreshold": 65,
          "DisplayGraph": false, "DisplayOnMarketAnalyzerList": false
        }
      ]
    },

    // Global settings are evaluated in order; the first matching setting wins.
    // Triggers demonstrate the supported legacy PriceTrend / volume model.
    // PairsProperties, DCAProperties and IndicatorsProperties adjustments below
    // are deliberately commented out. Activate only after reviewing PT properties.
    // _OFFSET adds/subtracts an absolute amount; _OFFSETPERCENT changes a base value
    // by a relative percentage. A base property must exist in PT's defaults.
    "GlobalSettings": [
      {
        "SettingName": "RapidMarketDecline",
        "TriggerConnection": "A && (B || C)",
        "Triggers": [
          {"Tag": "A", "MarketTrendName": "1h", "MaxChange": -2},
          {"Tag": "B", "MarketTrendName": "6h", "MaxChange": -4},
          {"Tag": "C", "MarketTrendName": "24h", "MaxChange": -7}
        ],
        "PairsProperties": {
          // "DEFAULT_sell_only_mode_enabled": true,
          // "max_trading_pairs_OFFSET": -2,
          // "DEFAULT_min_buy_volume_OFFSETPERCENT": 50,
          // "DEFAULT_trailing_buy_OFFSETPERCENT": 25,
          // "DEFAULT_trailing_profit_OFFSETPERCENT": -20,
          // "DEFAULT_initial_cost_percentage_OFFSETPERCENT": -30
        },
        "DCAProperties": {
          // "DEFAULT_DCA_trailing_buy_OFFSETPERCENT": 20,
          // "DEFAULT_DCA_trailing_profit_OFFSETPERCENT": -15,
          // "DEFAULT_DCA_rebuy_timeout_OFFSET": 5
        },
        "IndicatorsProperties": {
          // "BB_period_OFFSET": 2, // Only if the corresponding indicator property exists
          // "RSI_period_OFFSETPERCENT": 10
        }
      },
      {
        "SettingName": "WeakOrSideways",
        "TriggerConnection": "AND",
        "Triggers": [
          {"MarketTrendName": "6h", "MinChange": -1, "MaxChange": 1},
          {"MarketTrendName": "24h", "MinChange": -2, "MaxChange": 2}
        ],
        "PairsProperties": {
          // "max_trading_pairs_OFFSET": -1,
          // "DEFAULT_trailing_buy_OFFSET": 0.1,
          // "DEFAULT_trailing_profit_OFFSETPERCENT": -10,
          // "DEFAULT_A_sell_value_OFFSET": -0.25
        },
        "DCAProperties": {
          // "DEFAULT_DCA_trailing_buy_OFFSET": 0.15,
          // "DEFAULT_DCA_trailing_profit_OFFSETPERCENT": -10
        },
        "IndicatorsProperties": {
          // "EMA_period_OFFSET": 3
        }
      },
      {
        "SettingName": "BroadUptrend",
        "TriggerConnection": "AND",
        "Triggers": [
          {"MarketTrendName": "1h", "MinChange": 0},
          {"MarketTrendName": "6h", "MinChange": 1},
          {"MarketTrendName": "24h", "MinChange": 2}
        ],
        "PairsProperties": {
          // "max_trading_pairs_OFFSET": 2,
          // "DEFAULT_initial_cost_percentage_OFFSETPERCENT": 15,
          // "DEFAULT_trailing_buy_OFFSETPERCENT": -10,
          // "DEFAULT_A_sell_value_OFFSETPERCENT": 10,
          // "DEFAULT_trailing_profit_OFFSET": 0.05
        },
        "DCAProperties": {
          // "DEFAULT_DCA_trailing_buy_OFFSETPERCENT": -10,
          // "DEFAULT_DCA_trailing_profit_OFFSETPERCENT": 15
        },
        "IndicatorsProperties": {
          // "RSI_period_OFFSET": -2
        }
      },
      {
        "SettingName": "PersistentUptrend",
        "TriggerConnection": "AND",
        "Triggers": [
          {"MarketTrendName": "24h", "MinChange": 4},
          {"MarketTrendName": "72h", "MinChange": 6}
        ],
        "PairsProperties": {
          // "max_trading_pairs_OFFSETPERCENT": 20,
          // "DEFAULT_A_sell_value_OFFSETPERCENT": 15,
          // "DEFAULT_trailing_buy_OFFSET": -0.05
        },
        "DCAProperties": {
          // "DEFAULT_DCA_trailing_profit_OFFSET": 0.1
        },
        "IndicatorsProperties": {}
      },
      {
        "SettingName": "Default",
        "PairsProperties": {"File": "PAIRS.properties"},
        "DCAProperties": {"File": "DCA.properties"},
        "IndicatorsProperties": {"File": "INDICATORS.properties"}
      }
    ],

    // SMS means Single Market Settings (per-asset filters).
    // StopProcessWhenTriggered=false allows subsequent matching SMS rules.
    // Later matching entries can replace earlier values for the same property.
    // All example trading adjustments below are comments only.
    "SingleMarketSettings": [
      {
        "SettingName": "YoungOrIlliquidMarketExample",
        "TriggerConnection": "OR",
        "StopProcessWhenTriggered": true,
        "Triggers": [
          {"AgeDaysLowerThan": 14},
          {"Max24hVolume": 1000000}
        ],
        "PairsProperties": {
          // "DEFAULT_trading_enabled": false,
          // "DEFAULT_sell_only_mode_enabled": true,
          // "DEFAULT_DCA_enabled": false,
          // "DEFAULT_initial_cost_percentage_OFFSETPERCENT": -50
        },
        "DCAProperties": {
          // "DEFAULT_DCA_trailing_buy_OFFSETPERCENT": 25
        },
        "IndicatorsProperties": {}
      },
      {
        "SettingName": "IndividualOverextensionExample",
        "TriggerConnection": "A || B",
        "StopProcessWhenTriggered": false,
        "IgnoredMarkets": "", "AllowedMarkets": "",
        "IgnoredGlobalSettings": "", "AllowedGlobalSettings": "",
        "Triggers": [
          {"Tag": "A", "MarketTrendName": "1h", "MarketTrendRelation": "Relative", "MinChange": 7},
          {"Tag": "B", "MarketTrendName": "6h", "MarketTrendRelation": "Absolute", "MinChange": 12}
        ],
        "OffTriggerConnection": "AND",
        "RefreshOffTriggers": true,
        "OffTriggers": [{"HoursSinceTriggered": 2}],
        "PairsProperties": {
          // "DEFAULT_trailing_buy_OFFSETPERCENT": 30,
          // "DEFAULT_A_sell_value_OFFSETPERCENT": 15,
          // "DEFAULT_trailing_profit_OFFSET": 0.1,
          // "DEFAULT_min_buy_volume_OFFSETPERCENT": 50
        },
        "DCAProperties": {
          // "DEFAULT_DCA_trailing_buy_OFFSET": 0.1,
          // "DEFAULT_DCA_trailing_profit_OFFSETPERCENT": 10
        },
        "IndicatorsProperties": {
          // "RSI_period_OFFSET": 1
        }
      },
      {
        "SettingName": "IndividualWeaknessExample",
        "TriggerConnection": "AND",
        "StopProcessWhenTriggered": false,
        "Triggers": [
          {"MarketTrendName": "1h", "MarketTrendRelation": "Relative", "MaxChange": -3},
          {"MarketTrendName": "6h", "MarketTrendRelation": "Absolute", "MaxChange": -5}
        ],
        "OffTriggers": [{"HoursSinceTriggered": 1}],
        "PairsProperties": {
          // "DEFAULT_sell_only_mode_enabled": true,
          // "DEFAULT_trailing_buy_OFFSET": 0.15,
          // "DEFAULT_initial_cost_percentage_OFFSETPERCENT": -20
        },
        "DCAProperties": {
          // "DEFAULT_DCA_trailing_buy_OFFSETPERCENT": 20,
          // "DEFAULT_DCA_trailing_profit_OFFSET": -0.1
        },
        "IndicatorsProperties": {
          // "EMA_period_OFFSETPERCENT": 10
        }
      }
    ]
  }
}
